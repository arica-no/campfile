# The everyday settings, explained; all of them: docs/DEPLOY-ADVANCED.md, "Settings reference". Do not copy this file over an existing .env: that deletes install.sh's answers.
# Local use needs no .env: docker compose up -d --build, then open http://localhost:8787.
# Database credentials and login secrets are generated once in the settings volume. Back it up with data.
# To change a setting, put its line in .env (create the file if there is none), then: docker compose up -d
# For HTTPS: set APP_ORIGIN and COMPOSE_PROFILES=https (and SMTP, so others can sign in), then: docker compose up -d --build

# One address for the app and shared pages. HTTPS needs DNS pointing at this server and ports 80/443 open.
APP_ORIGIN=http://localhost:8787
# HTTPS through the bundled Caddy, which gets the certificate for APP_ORIGIN.
# COMPOSE_PROFILES=https

# Authorize this sender with your SMTP service; ADMIN_EMAIL receives new account and page notices.
# EMAIL_FROM=Campfile <signin@example.com>
# ADMIN_EMAIL=you@example.com

# No SMTP: every email, sign-in codes included, is printed in docker compose logs campfile instead of sent. Enough to sign in yourself; set SMTP before sharing with others.
# Port 465 uses TLS immediately; other ports require STARTTLS with a valid certificate.
SMTP_HOST=
SMTP_PORT=
# Set both for authenticated SMTP, or leave both empty for a relay that accepts unauthenticated mail.
SMTP_USER=
# Single quotes preserve $ and spaces: SMTP_PASSWORD='a$password'
SMTP_PASSWORD=

# Single-user mode, for a server only you use, without SMTP: OWNER_EMAIL may then type OWNER_PASSWORD (12+ characters) wherever
# a sign-in code is asked for: the login, the AI connector and an agent's sign-in. Ignored once SMTP_HOST is set.
OWNER_EMAIL=
OWNER_PASSWORD=

# Existing installations: retain any explicit POSTGRES_PASSWORD, DATABASE_URL, PREVIEW_SECRET and
# CONSENT_SECRET from your old .env. Nonempty values override generated settings; nothing rotates automatically.
# An existing pgdata volume without settings needs its original password and secrets. See docs/DEPLOY-ADVANCED.md, "Settings and secrets".
# Separate app/viewer sites and external PostgreSQL are advanced configurations, not prerequisites.
